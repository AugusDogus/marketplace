{
  "expo": {
    "name": "Marketplace",
    "slug": "marketplace",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-marketplace.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.augie.marketplace",
      "adaptiveIcon": {
        "backgroundColor": "#0866FF",
        "foregroundImage": "./assets/android-icon-foreground-marketplace.png",
        "backgroundImage": "./assets/android-icon-background-marketplace.png",
        "monochromeImage": "./assets/android-icon-monochrome-marketplace.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon-marketplace.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "@preeternal/react-native-cookie-manager",
        {
          "androidWebkitVersion": "1.16.0"
        }
      ],
      "expo-background-task",
      [
        "expo-notifications",
        {
          "color": "#1877F2",
          "defaultChannel": "marketplace-alerts"
        }
      ]
    ]
  }
}
